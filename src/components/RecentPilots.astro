---
export interface Props {
  title?: string;
}

const { title = 'Recently Joined Pilots' } = Astro.props;
---

<div class="recent-pilots-section" id="recent-pilots">
  <div class="rp-container">

    <!-- Header -->
    <div class="rp-header">
      <h2 class="rp-title">{title}</h2>
      <div class="rp-weekly-badge" id="rp-weekly-badge">
        <span class="rp-weekly-count skeleton-text">—</span>
        <span class="rp-weekly-label">joined this week</span>
      </div>
    </div>

    <!-- Pilot cards -->
    <div class="rp-cards-wrapper">
      <div class="rp-cards" id="rp-cards">
        <!-- Skeleton cards -->
        {[1, 2, 3, 4, 5].map(() => (
          <div class="rp-card rp-skeleton">
            <div class="rp-card-avatar skeleton-pulse"></div>
            <div class="rp-card-info">
              <div class="skeleton-line skeleton-line-name"></div>
              <div class="skeleton-line skeleton-line-sub"></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- CTA -->
    <div class="rp-cta">
      <p class="rp-cta-text">Ready to join them in the skies?</p>
      <a href="/apply" class="rp-cta-btn">
        Apply Now
        <svg class="rp-cta-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

    <!-- Error state (hidden by default) -->
    <div class="rp-error hidden" id="rp-error">
      <p>Unable to load recent pilots. But you could be next!</p>
      <a href="/apply" class="rp-cta-btn" style="margin-top: 0.75rem; display: inline-flex;">
        Apply Now
        <svg class="rp-cta-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

  </div>
</div>

<style>
  .recent-pilots-section {
    padding: 2.5rem 1.5rem;
    background: #fdf8f9;
  }

  .rp-container {
    max-width: 64rem;
    margin: 0 auto;
  }

  .rp-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .rp-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #8B1538;
    margin-bottom: 0.5rem;
  }

  .rp-weekly-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: white;
    border: 1px solid #ead9df;
    border-radius: 999px;
    padding: 0.3rem 1rem;
    font-size: 0.85rem;
    color: #555;
  }

  .rp-weekly-count {
    font-weight: 800;
    color: #6e0038;
    font-size: 1.1rem;
  }

  .rp-weekly-label {
    font-weight: 500;
  }

  .rp-cards-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 0 -0.5rem;
    padding: 0 0.5rem;
  }

  .rp-cards-wrapper::-webkit-scrollbar {
    display: none;
  }

  .rp-cards {
    display: flex;
    gap: 0.75rem;
    padding: 0.25rem 0;
    min-width: min-content;
  }

  .rp-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: white;
    border: 1px solid #ead9df;
    border-radius: 1rem;
    padding: 0.75rem 1rem;
    min-width: 210px;
    flex-shrink: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .rp-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(139, 21, 56, 0.08);
  }

  .rp-card-avatar {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: linear-gradient(135deg, #8B1538, #b04a69);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .rp-card-info {
    min-width: 0;
  }

  .rp-card-name {
    font-weight: 700;
    color: #2f2f2f;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rp-card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }

  .rp-grade-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: #f8f1f3;
    color: #8B1538;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .rp-time {
    font-size: 0.72rem;
    color: #999;
    white-space: nowrap;
  }

  .rp-cta {
    text-align: center;
    margin-top: 1.75rem;
  }

  .rp-cta-text {
    color: #777;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .rp-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, #6e0038, #8B1538);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.6rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .rp-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(110, 0, 56, 0.3);
  }

  .rp-cta-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .rp-cta-btn:hover .rp-cta-arrow {
    transform: translateX(3px);
  }

  .rp-error {
    text-align: center;
    color: #999;
    font-size: 0.85rem;
  }

  /* Skeleton loading */
  .rp-skeleton {
    pointer-events: none;
  }

  .skeleton-pulse {
    background: linear-gradient(90deg, #e8dce0 25%, #f0e8ea 50%, #e8dce0 75%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.4s ease-in-out infinite;
  }

  .rp-card-avatar.skeleton-pulse {
    border-radius: 999px;
  }

  .skeleton-line {
    height: 0.7rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #e8dce0 25%, #f0e8ea 50%, #e8dce0 75%);
    background-size: 200% 100%;
    animation: skeleton-shimmer 1.4s ease-in-out infinite;
  }

  .skeleton-line-name {
    width: 90px;
  }

  .skeleton-line-sub {
    width: 55px;
    margin-top: 0.4rem;
  }

  .skeleton-text {
    opacity: 0.4;
  }

  @keyframes skeleton-shimmer {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 768px) {
    .recent-pilots-section {
      padding: 2rem 1rem;
    }

    .rp-title {
      font-size: 1.4rem;
    }

    .rp-cards {
      gap: 0.5rem;
    }

    .rp-card {
      min-width: 180px;
      padding: 0.6rem 0.85rem;
    }

    .rp-card-avatar {
      width: 36px;
      height: 36px;
      font-size: 0.8rem;
    }

    .rp-card-name {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  interface RecentPilot {
    ifc_name: string;
    ifc_grade: number;
    reviewed_at: string;
  }

  interface RecentPilotsData {
    status: number;
    result: {
      weekly_count: number;
      pilots: RecentPilot[];
    };
  }

  function timeAgo(dateStr: string): string {
    const now = Date.now();
    const then = new Date(dateStr.replace(' ', 'T') + 'Z').getTime();
    const diffMs = now - then;

    if (isNaN(then) || diffMs < 0) return 'Just now';

    const mins = Math.floor(diffMs / 60000);
    if (mins < 1) return 'Just now';
    if (mins < 60) return `${mins}m ago`;

    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours}h ago`;

    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;

    const weeks = Math.floor(days / 7);
    if (weeks < 5) return `${weeks}w ago`;

    const months = Math.floor(days / 30);
    return `${months}mo ago`;
  }

  function getInitials(name: string): string {
    return name
      .split(/[\s._-]+/)
      .filter(Boolean)
      .slice(0, 2)
      .map(s => s[0]?.toUpperCase() || '')
      .join('');
  }

  function renderPilots(data: RecentPilotsData) {
    const cardsContainer = document.getElementById('rp-cards');
    const weeklyBadge = document.getElementById('rp-weekly-badge');
    const errorEl = document.getElementById('rp-error');

    if (!cardsContainer || !weeklyBadge) return;

    // Update weekly count
    const count = data.result.weekly_count;
    weeklyBadge.innerHTML = `
      <span class="rp-weekly-count">${count}</span>
      <span class="rp-weekly-label">joined this week</span>
    `;

    // Render pilot cards
    const pilots = data.result.pilots || [];
    if (pilots.length === 0) {
      cardsContainer.innerHTML = `
        <div class="rp-card" style="min-width: auto; flex: 1; justify-content: center;">
          <span style="color: #999; font-size: 0.85rem;">Be the next to join!</span>
        </div>
      `;
      return;
    }

    cardsContainer.innerHTML = pilots.map((pilot) => `
      <div class="rp-card">
        <div class="rp-card-avatar">${getInitials(pilot.ifc_name)}</div>
        <div class="rp-card-info">
          <div class="rp-card-name">${escapeHtml(pilot.ifc_name)}</div>
          <div class="rp-card-meta">
            <span class="rp-grade-badge">G${pilot.ifc_grade}</span>
            <span class="rp-time">${timeAgo(pilot.reviewed_at)}</span>
          </div>
        </div>
      </div>
    `).join('');
  }

  function escapeHtml(str: string): string {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function showError() {
    const cardsContainer = document.getElementById('rp-cards');
    const weeklyBadge = document.getElementById('rp-weekly-badge');
    const errorEl = document.getElementById('rp-error');
    const ctaEl = document.querySelector('.rp-cta') as HTMLElement | null;

    if (cardsContainer) cardsContainer.classList.add('hidden');
    if (weeklyBadge) weeklyBadge.classList.add('hidden');
    if (ctaEl) ctaEl.classList.add('hidden');
    if (errorEl) errorEl.classList.remove('hidden');
  }

  async function fetchRecentPilots() {
    try {
      const res = await fetch('https://crew.qatarivirtual.xyz/api.php/recent-pilots');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data: RecentPilotsData = await res.json();
      if (data.status === 0 && data.result) {
        renderPilots(data);
      } else {
        showError();
      }
    } catch {
      showError();
    }
  }

  fetchRecentPilots();
</script>
