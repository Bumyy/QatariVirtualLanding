---
import { fetchApiData } from '../utils/api.ts';

export interface Props {
  title?: string;
}

const { title = 'Recently Joined Pilots' } = Astro.props;

interface RecentPilot {
  ifc_name: string;
  ifc_grade: number;
  reviewed_at: string;
}

interface RecentPilotsData {
  status: number;
  result: {
    weekly_count: number;
    pilots: RecentPilot[];
  };
}

let weeklyCount: number | null = null;
let pilots: RecentPilot[] = [];

try {
  const data: RecentPilotsData = await fetchApiData('recent-pilots');
  if (data.status === 0 && data.result) {
    weeklyCount = data.result.weekly_count;
    pilots = data.result.pilots || [];
  }
} catch {
  // will render fallback below
}

function getInitials(name: string): string {
  return name
    .split(/[\s._-]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map(s => s[0]?.toUpperCase() || '')
    .join('');
}

const hasData = weeklyCount !== null;
---

<div class="recent-pilots-section" id="recent-pilots">
  <div class="rp-container">

    <!-- Header -->
    <div class="rp-header">
      <h2 class="rp-title">{title}</h2>
      <div class="rp-weekly-badge">
        <span class="rp-weekly-count">{hasData ? weeklyCount : '—'}</span>
        <span class="rp-weekly-label">joined this week</span>
      </div>
    </div>

    <!-- Pilot cards -->
    <div class="rp-cards-wrapper">
      <div class="rp-cards">
        {hasData && pilots.length > 0 ? pilots.map((pilot) => (
          <div class="rp-card">
            <div class="rp-card-avatar">{getInitials(pilot.ifc_name)}</div>
            <div class="rp-card-info">
              <div class="rp-card-name">{pilot.ifc_name}</div>
              <div class="rp-card-meta">
                <span class="rp-grade-badge">G{pilot.ifc_grade}</span>
                <span class="rp-time" data-time={pilot.reviewed_at}>{pilot.reviewed_at}</span>
              </div>
            </div>
          </div>
        )) : (
          <div class="rp-card rp-empty-card">
            <span>Be the next to join!</span>
          </div>
        )}
      </div>
    </div>

    <!-- CTA -->
    <div class="rp-cta">
      <p class="rp-cta-text">Ready to join them in the skies?</p>
      <a href="/apply" class="rp-cta-btn">
        Apply Now
        <svg class="rp-cta-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>

  </div>
</div>

<style>
  .recent-pilots-section {
    padding: 2.5rem 1.5rem;
    background: #fdf8f9;
  }

  .rp-container {
    max-width: 64rem;
    margin: 0 auto;
  }

  .rp-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .rp-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #8B1538;
    margin-bottom: 0.5rem;
  }

  .rp-weekly-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: white;
    border: 1px solid #ead9df;
    border-radius: 999px;
    padding: 0.3rem 1rem;
    font-size: 0.85rem;
    color: #555;
  }

  .rp-weekly-count {
    font-weight: 800;
    color: #6e0038;
    font-size: 1.1rem;
  }

  .rp-weekly-label {
    font-weight: 500;
  }

  .rp-cards-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 0 -0.5rem;
    padding: 0 0.5rem;
  }

  .rp-cards-wrapper::-webkit-scrollbar {
    display: none;
  }

  .rp-cards {
    display: flex;
    gap: 0.75rem;
    padding: 0.25rem 0;
    min-width: min-content;
  }

  .rp-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: white;
    border: 1px solid #ead9df;
    border-radius: 1rem;
    padding: 0.75rem 1rem;
    min-width: 210px;
    flex-shrink: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .rp-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(139, 21, 56, 0.08);
  }

  .rp-empty-card {
    min-width: auto;
    flex: 1;
    justify-content: center;
    color: #999;
    font-size: 0.85rem;
  }

  .rp-card-avatar {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    background: linear-gradient(135deg, #8B1538, #b04a69);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.95rem;
    flex-shrink: 0;
  }

  .rp-card-info {
    min-width: 0;
  }

  .rp-card-name {
    font-weight: 700;
    color: #2f2f2f;
    font-size: 0.9rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rp-card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }

  .rp-grade-badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: #f8f1f3;
    color: #8B1538;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .rp-time {
    font-size: 0.72rem;
    color: #999;
    white-space: nowrap;
  }

  .rp-cta {
    text-align: center;
    margin-top: 1.75rem;
  }

  .rp-cta-text {
    color: #777;
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .rp-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: linear-gradient(135deg, #6e0038, #8B1538);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.6rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .rp-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(110, 0, 56, 0.3);
  }

  .rp-cta-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .rp-cta-btn:hover .rp-cta-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 768px) {
    .recent-pilots-section {
      padding: 2rem 1rem;
    }

    .rp-title {
      font-size: 1.4rem;
    }

    .rp-cards {
      gap: 0.5rem;
    }

    .rp-card {
      min-width: 180px;
      padding: 0.6rem 0.85rem;
    }

    .rp-card-avatar {
      width: 36px;
      height: 36px;
      font-size: 0.8rem;
    }

    .rp-card-name {
      font-size: 0.82rem;
    }
  }
</style>

<script>
  function timeAgo(dateStr: string): string {
    const now = Date.now();
    const then = new Date(dateStr.replace(' ', 'T') + 'Z').getTime();
    const diffMs = now - then;

    if (isNaN(then) || diffMs < 0) return 'Just now';

    const mins = Math.floor(diffMs / 60000);
    if (mins < 1) return 'Just now';
    if (mins < 60) return `${mins}m ago`;

    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours}h ago`;

    const days = Math.floor(hours / 24);
    if (days < 7) return `${days}d ago`;

    const weeks = Math.floor(days / 7);
    if (weeks < 5) return `${weeks}w ago`;

    const months = Math.floor(days / 30);
    return `${months}mo ago`;
  }

  document.querySelectorAll<HTMLElement>('.rp-time').forEach(el => {
    const raw = el.dataset.time;
    if (raw) el.textContent = timeAgo(raw);
  });
</script>
