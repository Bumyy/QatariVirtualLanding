---
import Layout from '../layouts/Layout.astro';
import { fetchApiData } from '../utils/api.ts';
import airlinesData from '../assets/airlines.json';

interface Route {
  id: number;
  fltnum: string;
  dep: string;
  arr: string;
  duration: number;
  airline_id?: number;
  aircraft?: { name: string; liveryname: string }[];
}

let routes: Route[] = [];
let error: string | null = null;

try {
  const data = await fetchApiData('routes');
  if (data.status === 0 && Array.isArray(data.result)) {
    routes = data.result.sort((a, b) => {
      const aQR = a.fltnum?.startsWith('QR') ? 0 : 1;
      const bQR = b.fltnum?.startsWith('QR') ? 0 : 1;
      if (aQR !== bQR) return aQR - bQR;
      return (a.fltnum || '').localeCompare(b.fltnum || '');
    });
  } else {
    error = 'Failed to load route data.';
  }
} catch (e) {
  error = 'Route data unavailable right now.';
}

const airlines = airlinesData.airlines;
const totalRoutes = routes.length;

// Extract unique aircraft and livery configurations from the routes
const allAircraft = Array.from(
  new Map(
    routes
      .flatMap(r => r.aircraft || [])
      .filter(ac => ac && ac.name && ac.liveryname)
      .map(ac => [`${ac.name} (${ac.liveryname})`, ac])
  ).values()
).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Route Database | Qatari Virtual" description="Browse Qatari Virtual's complete route database with 5,000+ flights. Search and filter by flight number, departure, arrival, and aircraft type.">
<section class="px-6 py-8 min-h-screen">
  <div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-start gap-4 mb-3">
      <h1 class="text-3xl sm:text-5xl font-bold text-[#8B1538]">Route Database</h1>
      <p class="text-sm text-gray-500 pt-2 hidden sm:inline">
        <a href="/" class="text-[#8B1538] font-semibold hover:underline">Home</a> / Route Database
      </p>
    </div>
    <p class="max-w-3xl text-base sm:text-lg text-gray-600 leading-relaxed mb-3">
      Explore our complete route network. Search and filter by airline, departure, or arrival.
    </p>
    <a href="/map" class="inline-flex items-center gap-1 text-sm text-[#8B1538] font-semibold hover:underline mb-5">
      View Route Map &rarr;
    </a>

    {error && (<div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-5 py-3 mb-6 text-sm">{error}</div>)}

    <div class="flex flex-wrap items-center gap-2.5 mb-5 z-20">
      <!-- Custom Searchable Dropdown for Airline -->
      <div class="relative search-select w-full sm:w-[200px]" id="airline-select-wrapper">
        <input 
          id="filter-airline-display"
          type="text" 
          placeholder="All Airlines" 
          class="filter-input w-full pr-8 cursor-pointer"
          autocomplete="off"
        />
        <input id="filter-airline" type="hidden" value="" />
        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
        <div class="search-select-dropdown absolute left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-white border border-[#ead9df] rounded-xl shadow-lg z-50 hidden opacity-0 scale-95 transition-all duration-200 origin-top">
          <div class="py-1">
            <div class="search-select-option px-4 py-2 text-sm text-gray-700 hover:bg-[#f8f1f3] hover:text-[#8B1538] cursor-pointer font-medium" data-value="">All Airlines</div>
            {airlines.map(a => (
              <div class="search-select-option px-4 py-2 text-sm text-gray-700 hover:bg-[#f8f1f3] hover:text-[#8B1538] cursor-pointer" data-value={a.suffix ? `${a.prefix}_${a.suffix}` : a.prefix}>
                {a.name}
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Custom Searchable Dropdown for Aircraft -->
      <div class="relative search-select w-full sm:w-[230px]" id="aircraft-select-wrapper">
        <input 
          id="filter-aircraft-display"
          type="text" 
          placeholder="All Aircraft (Livery)" 
          class="filter-input w-full pr-8 cursor-pointer"
          autocomplete="off"
        />
        <input id="filter-aircraft" type="hidden" value="" />
        <div class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
        <div class="search-select-dropdown absolute left-0 right-0 mt-1 max-h-60 overflow-y-auto bg-white border border-[#ead9df] rounded-xl shadow-lg z-50 hidden opacity-0 scale-95 transition-all duration-200 origin-top">
          <div class="py-1">
            <div class="search-select-option px-4 py-2 text-sm text-gray-700 hover:bg-[#f8f1f3] hover:text-[#8B1538] cursor-pointer font-medium" data-value="">All Aircraft</div>
            {allAircraft.map(ac => (
              <div class="search-select-option px-4 py-2 text-sm text-gray-700 hover:bg-[#f8f1f3] hover:text-[#8B1538] cursor-pointer" data-value={`${ac.name} (${ac.liveryname})`}>
                {ac.name} <span class="text-xs text-gray-400">({ac.liveryname})</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <input id="filter-dep" type="text" placeholder="Departure" class="filter-input w-full sm:w-[110px]" />
      <input id="filter-arr" type="text" placeholder="Arrival" class="filter-input w-full sm:w-[110px]" />
      <button id="filter-btn" class="bg-[#8B1538] text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-[#6e0038] transition w-full sm:w-auto">Search</button>
      <span class="text-sm text-gray-500 sm:ml-auto w-full sm:w-auto text-right mt-1 sm:mt-0 block sm:inline" id="route-count">{totalRoutes.toLocaleString()} routes</span>
    </div>

    <!-- desktop table -->
    <div class="hidden sm:block overflow-hidden rounded-2xl border border-[#ead9df] shadow-sm">
      <div class="overflow-auto" style="max-height: 70vh">
        <table class="w-full text-sm text-left" id="route-table">
          <thead class="sticky top-0 z-10 text-white" style="background: linear-gradient(135deg, #6e0038, #8B1538)">
            <tr>
              <th class="py-3 px-4 font-bold">Flt Num</th>
              <th class="py-3 px-4 font-bold">Dep</th>
              <th class="py-3 px-4 font-bold">Arr</th>
              <th class="py-3 px-4 font-bold">Aircraft &amp; Livery</th>
              <th class="py-3 px-4 font-bold cursor-pointer select-none" data-sort="duration">Duration <span class="sort-arrow ml-1">&#9650;</span></th>
            </tr>
          </thead>
          <tbody>
            {routes.map((route, i) => {
              const flightNumbers = (route.fltnum || '').split(',').map(f => f.trim()).filter(Boolean);
              const primaryFltnum = flightNumbers[0] || '';
              return (
                <tr
                  class={`route-row border-t border-[#ead9df] hover:bg-[#fcfafb] transition ${i % 2 === 0 ? 'bg-white' : 'bg-[#fdfbfc]'}`}
                  data-fltnum={route.fltnum || ''}
                  data-dep={route.dep || ''}
                  data-arr={route.arr || ''}
                  data-airline={(() => {
                    const match = airlines.find(a => a.suffix && (route.fltnum || '').includes(a.suffix) && (route.fltnum || '').startsWith(a.prefix))
                               || airlines.find(a => !a.suffix && (route.fltnum || '').startsWith(a.prefix));
                    return match ? (match.suffix ? `${match.prefix}_${match.suffix}` : match.prefix) : '';
                  })()}
                  data-aircraft={route.aircraft?.map(ac => `${ac.name} (${ac.liveryname})`).join(', ') || ''}
                  data-duration={route.duration || 0}
                >
                  <td class="py-2.5 px-4 font-medium text-gray-800">
                    <div class="flex flex-wrap items-center gap-1 max-w-[220px]">
                      {flightNumbers.slice(0, 2).map((num) => (
                        <span class="text-xs font-bold px-2 py-0.5 rounded-md text-[#8B1538] bg-[#f8f1f3] border border-[#ead9df]">{num}</span>
                      ))}
                      {flightNumbers.length > 2 && (
                        <span class="text-[10px] text-gray-500 font-semibold bg-gray-100 px-1.5 py-0.5 rounded border" title={flightNumbers.slice(2).join(', ')}>+{flightNumbers.length - 2}</span>
                      )}
                      <a href={`/map?fltnum=${primaryFltnum}`} class="text-gray-400 hover:text-[#8B1538] transition ml-1" title={`View route on map (${primaryFltnum})`}>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                      </a>
                    </div>
                  </td>
                  <td class="py-2.5 px-4 font-medium text-gray-700">{route.dep || '\u2014'}</td>
                  <td class="py-2.5 px-4 font-medium text-gray-700">{route.arr || '\u2014'}</td>
                  <td class="py-2.5 px-4">
                    <div class="flex flex-wrap items-center gap-1 ac-group">
                      {route.aircraft?.slice(0, 2).map((ac) => (
                        ac && <span class="ac-tag text-xs font-medium px-2 py-0.5 rounded-full border border-[#ead9df]" style="background:#f8f1f3;color:#8B1538">{ac.name} ({ac.liveryname})</span>
                      ))}
                      {(route.aircraft?.length || 0) > 2 && (
                        <>
                          {route.aircraft?.slice(2).map((ac) => (
                            ac && <span class="ac-tag ac-extra text-xs font-medium px-2 py-0.5 rounded-full border border-[#ead9df] hidden" style="background:#f8f1f3;color:#8B1538">{ac.name} ({ac.liveryname})</span>
                          ))}
                          <button class="ac-expand text-xs font-semibold px-2 py-0.5 rounded-full border transition" style="color:#8B1538;border-color:#ead9df;background:white">+{route.aircraft.length - 2}</button>
                        </>
                      )}
                    </div>
                  </td>
                  <td class="py-2.5 px-4 text-gray-500">{route.duration ? `${Math.floor(route.duration / 3600)}h ${Math.floor((route.duration % 3600) / 60)}m` : '\u2014'}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

    <!-- mobile cards -->
    <div class="sm:hidden space-y-3" id="mobile-list">
       {routes.map((route) => {
        const flightNumbers = (route.fltnum || '').split(',').map(f => f.trim()).filter(Boolean);
        const primaryFltnum = flightNumbers[0] || '';
        return (
          <div
            class="route-card bg-white rounded-2xl border border-[#ead9df] p-4 shadow-sm"
            data-fltnum={route.fltnum || ''}
            data-dep={route.dep || ''}
            data-arr={route.arr || ''}
            data-airline={(() => {
              const match = airlines.find(a => a.suffix && (route.fltnum || '').includes(a.suffix) && (route.fltnum || '').startsWith(a.prefix))
                         || airlines.find(a => !a.suffix && (route.fltnum || '').startsWith(a.prefix));
              return match ? (match.suffix ? `${match.prefix}_${match.suffix}` : match.prefix) : '';
            })()}
            data-aircraft={route.aircraft?.map(ac => `${ac.name} (${ac.liveryname})`).join(', ') || ''}
            data-duration={route.duration || 0}
          >
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2 flex-wrap max-w-[70%]">
                {flightNumbers.slice(0, 2).map((num) => (
                  <span class="text-sm font-bold px-2 py-0.5 rounded-md text-[#8B1538] bg-[#f8f1f3] border border-[#ead9df]">{num}</span>
                ))}
                {flightNumbers.length > 2 && (
                  <span class="text-[10px] text-gray-500 font-semibold bg-gray-100 px-1.5 py-0.5 rounded border" title={flightNumbers.slice(2).join(', ')}>+{flightNumbers.length - 2}</span>
                )}
                <a href={`/map?fltnum=${primaryFltnum}`} class="text-gray-400 hover:text-[#8B1538] transition p-0.5 ml-1" title={`View route on map (${primaryFltnum})`}>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                </a>
              </div>
              <span class="text-xs text-gray-400">{route.duration ? `${Math.floor(route.duration / 3600)}h ${Math.floor((route.duration % 3600) / 60)}m` : '\u2014'}</span>
            </div>
            <div class="flex items-center gap-3 text-sm mb-2">
              <span class="font-semibold text-gray-800">{route.dep || '\u2014'}</span>
              <svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
              <span class="font-semibold text-gray-800">{route.arr || '\u2014'}</span>
            </div>
            <div class="flex flex-wrap items-center gap-1 ac-group mb-2" data-route-id={route.id}>
              {route.aircraft?.slice(0, 2).map((ac) => (
                ac && <span class="ac-tag text-xs font-medium px-2 py-0.5 rounded-full border border-[#ead9df]" style="background:#f8f1f3;color:#8B1538">{ac.name} ({ac.liveryname})</span>
              ))}
              {(route.aircraft?.length || 0) > 2 && (
                <>
                  {route.aircraft?.slice(2).map((ac) => (
                    ac && <span class="ac-tag ac-extra text-xs font-medium px-2 py-0.5 rounded-full border border-[#ead9df] hidden" style="background:#f8f1f3;color:#8B1538">{ac.name} ({ac.liveryname})</span>
                  ))}
                  <button class="ac-expand text-xs font-semibold px-2 py-0.5 rounded-full border transition" style="color:#8B1538;border-color:#ead9df;background:white">+{route.aircraft.length - 2}</button>
                </>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <div class="text-center text-sm text-gray-400 mt-3" id="no-results" style="display:none">No routes match your filters.</div>
  </div>
</section>
</Layout>

<script>
  const filterAirline = document.getElementById('filter-airline') as HTMLInputElement;
  const filterAirlineDisplay = document.getElementById('filter-airline-display') as HTMLInputElement;
  const filterAircraft = document.getElementById('filter-aircraft') as HTMLInputElement;
  const filterAircraftDisplay = document.getElementById('filter-aircraft-display') as HTMLInputElement;
  const filterFltnum = document.getElementById('filter-fltnum') as HTMLInputElement;
  const filterDep = document.getElementById('filter-dep') as HTMLInputElement;
  const filterArr = document.getElementById('filter-arr') as HTMLInputElement;
  const routeCount = document.getElementById('route-count');
  const noResults = document.getElementById('no-results');
  const tableRows = document.querySelectorAll('.route-row');
  const cards = document.querySelectorAll('.route-card');
  const table = document.getElementById('route-table');

  function filterRows() {
    const qAirline = filterAirline?.value || '';
    const qAircraft = filterAircraft?.value || '';
    const qFlt = (filterFltnum?.value || '').toLowerCase();
    const qDep = (filterDep?.value || '').toLowerCase();
    const qArr = (filterArr?.value || '').toLowerCase();

    let visible = 0;

    tableRows.forEach(item => {
      const airline = (item.dataset.airline || '');
      const fltnum = (item.dataset.fltnum || '').toLowerCase();
      const depVal = (item.dataset.dep || '').toLowerCase();
      const arrVal = (item.dataset.arr || '').toLowerCase();
      const acVal = (item.dataset.aircraft || '').toLowerCase();

      const ok = (!qAirline || airline === qAirline)
        && (!qAircraft || acVal.includes(qAircraft.toLowerCase()))
        && (!qFlt || fltnum.includes(qFlt))
        && (!qDep || depVal.includes(qDep))
        && (!qArr || arrVal.includes(qArr));

      (item as HTMLElement).style.display = ok ? '' : 'none';
      if (ok) visible++;
    });

    cards.forEach(item => {
      const airline = (item.dataset.airline || '');
      const fltnum = (item.dataset.fltnum || '').toLowerCase();
      const depVal = (item.dataset.dep || '').toLowerCase();
      const arrVal = (item.dataset.arr || '').toLowerCase();
      const acVal = (item.dataset.aircraft || '').toLowerCase();

      const ok = (!qAirline || airline === qAirline)
        && (!qAircraft || acVal.includes(qAircraft.toLowerCase()))
        && (!qFlt || fltnum.includes(qFlt))
        && (!qDep || depVal.includes(qDep))
        && (!qArr || arrVal.includes(qArr));

      (item as HTMLElement).style.display = ok ? '' : 'none';
      if (ok && !tableRows.length) visible++;
    });

    const totalCount = tableRows.length || cards.length;
    if (routeCount) routeCount.textContent = `${visible.toLocaleString()} of ${totalCount.toLocaleString()} routes`;
    if (noResults) noResults.style.display = visible === 0 ? '' : 'none';

    // sync URL
    const params = new URLSearchParams();
    if (qAirline) params.set('airline', qAirline);
    if (qAircraft) params.set('aircraft', qAircraft);
    if (qFlt) params.set('flt', qFlt);
    if (qDep) params.set('dep', qDep);
    if (qArr) params.set('arr', qArr);
    const newUrl = params.toString() ? `${window.location.pathname}?${params.toString()}` : window.location.pathname;
    window.history.replaceState({}, '', newUrl);
  }

  // Setup custom searchable dropdowns
  function setupSearchSelect(wrapperId: string, hiddenInputId: string, displayInputId: string, placeholderText: string) {
    const wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;

    const displayInput = document.getElementById(displayInputId) as HTMLInputElement;
    const hiddenInput = document.getElementById(hiddenInputId) as HTMLInputElement;
    const dropdown = wrapper.querySelector('.search-select-dropdown') as HTMLElement;
    const options = wrapper.querySelectorAll('.search-select-option');

    function showDropdown() {
      // Close other dropdowns first
      document.querySelectorAll('.search-select-dropdown').forEach(d => {
        if (d !== dropdown) {
          d.classList.add('opacity-0', 'scale-95');
          setTimeout(() => d.classList.add('hidden'), 200);
        }
      });

      dropdown.classList.remove('hidden');
      setTimeout(() => {
        dropdown.classList.remove('opacity-0', 'scale-95');
      }, 10);
    }

    function hideDropdown() {
      dropdown.classList.add('opacity-0', 'scale-95');
      setTimeout(() => {
        dropdown.classList.add('hidden');
      }, 200);
    }

    displayInput.addEventListener('click', (e) => {
      e.stopPropagation();
      showDropdown();
    });

    displayInput.addEventListener('focus', () => {
      showDropdown();
    });

    displayInput.addEventListener('input', () => {
      const q = displayInput.value.toLowerCase().trim();
      options.forEach(opt => {
        const text = opt.textContent?.toLowerCase() || '';
        const val = (opt as HTMLElement).dataset.value || '';
        const isMatch = text.includes(q) || val.toLowerCase().includes(q);
        (opt as HTMLElement).style.display = isMatch ? '' : 'none';
      });
    });

    options.forEach(opt => {
      opt.addEventListener('click', (e) => {
        e.stopPropagation();
        const val = (opt as HTMLElement).dataset.value || '';
        const text = val ? opt.textContent?.trim() || '' : '';
        
        hiddenInput.value = val;
        displayInput.value = text;
        
        options.forEach(o => (o as HTMLElement).style.display = '');
        hideDropdown();
        filterRows();
      });
    });

    document.addEventListener('click', (e) => {
      if (!wrapper.contains(e.target as Node)) {
        hideDropdown();
        
        // Reset check
        const currentVal = hiddenInput.value;
        const matchingOpt = Array.from(options).find(o => (o as HTMLElement).dataset.value === currentVal);
        if (matchingOpt && currentVal) {
          displayInput.value = matchingOpt.textContent?.trim() || '';
        } else {
          displayInput.value = '';
          hiddenInput.value = '';
        }
        options.forEach(o => (o as HTMLElement).style.display = '');
      }
    });
  }

  // Initialize SearchSelect dropdowns
  setupSearchSelect('airline-select-wrapper', 'filter-airline', 'filter-airline-display', 'All Airlines');
  setupSearchSelect('aircraft-select-wrapper', 'filter-aircraft', 'filter-aircraft-display', 'All Aircraft');

  // load filters from URL on page load
  const params = new URLSearchParams(window.location.search);
  
  if (params.get('airline') && filterAirline && filterAirlineDisplay) {
    const val = params.get('airline')!;
    filterAirline.value = val;
    const opt = document.querySelector(`#airline-select-wrapper .search-select-option[data-value="${val}"]`);
    if (opt) filterAirlineDisplay.value = opt.textContent?.trim() || '';
  }

  if (params.get('aircraft') && filterAircraft && filterAircraftDisplay) {
    const val = params.get('aircraft')!;
    filterAircraft.value = val;
    const opt = document.querySelector(`#aircraft-select-wrapper .search-select-option[data-value="${val}"]`);
    if (opt) filterAircraftDisplay.value = opt.textContent?.trim() || '';
  }

  if (params.get('flt') && filterFltnum) filterFltnum.value = params.get('flt')!;
  if (params.get('dep') && filterDep) filterDep.value = params.get('dep')!;
  if (params.get('arr') && filterArr) filterArr.value = params.get('arr')!;
  if (params.toString()) filterRows();

  const filterBtn = document.getElementById('filter-btn');
  filterBtn?.addEventListener('click', filterRows);

  // Allow pressing "Enter" inside the text boxes to trigger the search
  const handleEnter = (e: KeyboardEvent) => { if (e.key === 'Enter') filterRows(); };
  filterDep?.addEventListener('keypress', handleEnter);
  filterArr?.addEventListener('keypress', handleEnter);

  // sort
  let currentSort = { key: null as string | null, asc: true };

  table?.querySelectorAll('[data-sort]').forEach(th => {
    th.addEventListener('click', () => {
      const key = th.dataset.sort!;
      if (currentSort.key === key) { currentSort.asc = !currentSort.asc; }
      else { currentSort.key = key; currentSort.asc = true; }

      const tbody = table.querySelector('tbody');
      if (!tbody) return;
      const arr = Array.from(tbody.querySelectorAll('.route-row'));

      arr.sort((a, b) => {
        const aVal = (a.dataset[key as string] || '').toLowerCase();
        const bVal = (b.dataset[key as string] || '').toLowerCase();
        if (key === 'duration') {
          return currentSort.asc ? Number(aVal) - Number(bVal) : Number(bVal) - Number(aVal);
        }
        return currentSort.asc ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
      });

      arr.forEach(r => tbody.appendChild(r));
    });
  });

  // expand aircraft
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.ac-expand');
    if (!btn) return;
    const group = btn.closest('.ac-group');
    if (!group) return;
    const extras = group.querySelectorAll('.ac-extra');
    const isExpanded = btn.dataset.open === '1';
    if (isExpanded) {
      extras.forEach(el => (el as HTMLElement).classList.add('hidden'));
      btn.textContent = `+${extras.length}`;
      btn.dataset.open = '0';
    } else {
      extras.forEach(el => (el as HTMLElement).classList.remove('hidden'));
      btn.textContent = '\u2013 less';
      btn.dataset.open = '1';
    }
  });
</script>

